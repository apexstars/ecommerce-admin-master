NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173

# Admin and customer tokens use different secrets AND audiences, so one can never
# be replayed as the other. Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-characters-long
CUSTOMER_JWT_SECRET=change-me-customer-secret-at-least-32-characters-long
ADMIN_ACCESS_TTL_SECONDS=900
ADMIN_SESSION_TTL_SECONDS=28800
CUSTOMER_ACCESS_TTL_SECONDS=604800

# Leave STRIPE_SECRET_KEY empty to use the built-in fake provider (accepts Stripe
# test tokens like pm_card_visa / pm_card_chargeDeclined).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_PUBLIC_URL=http://localhost:9000/product-images

LOW_STOCK_THRESHOLD=10
TAX_RATE_BPS=800
FLAT_SHIPPING_CENTS=800
FREE_SHIPPING_OVER_CENTS=10000

# Run the outbox dispatcher inside the API process (handy for dev). In production
# set false and run `npm run worker` as a separate process.
RUN_WORKER_IN_PROCESS=true
